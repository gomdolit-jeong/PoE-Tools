@using System.Globalization
@using PoEBuildGacha.Web.Gacha
@inject TimelessChanges Changes
@inject StarterBuildStore StarterBuilds

@* 군단 주얼 시드 찾기: 고른 노드에서 나올 수 있는 패시브마다 가중치를 주고, (개수 × 가중치) 합이 큰 시드를 찾습니다. *@
@if (Chosen.Count == 0)
{
    <p class="tj-help">
        위 확대 그림에서 "찍을 노드로 고르기"를 켜고 찍을 노드들을 누르세요.
        그 노드들에서 나올 수 있는 패시브 목록이 여기에 나오고, 원하는 것에 가중치를 주면 맞는 시드를 찾아 드려요.
    </p>
}
else if (outcomes is null)
{
    <p class="tj-help @(failed ? "bad" : "")">@(failed ? "변환표를 받지 못했어요. 잠시 뒤에 다시 시도해 주세요." : "나올 수 있는 패시브를 모으는 중이에요…")</p>
}
else
{
    <p class="tj-help">
        고른 노드 @(Chosen.Count)개에서 @Jewel.Korean 주얼로 나올 수 있는 패시브 @(outcomes.Length)가지예요.
        원하는 것에 가중치를 주세요 (원하지 않는 것은 음수). 시드 점수 = 나온 개수 × 가중치의 합
    </p>
    <div class="tj-finder-bar">
        <input class="tj-filter" placeholder="패시브 이름·설명 검색" @bind="filter" @bind:event="oninput" />
        <label class="check">
            <input type="checkbox" @bind="onlyWeighted" />
            <span>가중치 준 것만</span>
        </label>
    </div>
    <div class="tj-outcomes">
        @foreach (var o in VisibleOutcomes)
        {
            <div class="tj-outcome @(weights.GetValueOrDefault(o.Id) > 0 ? "plus" : weights.GetValueOrDefault(o.Id) < 0 ? "minus" : "")">
                <div class="tj-outcome-text">
                    <b>@o.Title</b>
                    @foreach (var line in o.Lines)
                    {
                        <small>@line</small>
                    }
                    <small class="tj-count">시드당 평균 @o.PerSeed.ToString("0.##", CultureInfo.InvariantCulture)개</small>
                </div>
                <input class="tj-weight" type="number" step="1" aria-label="@o.Title 가중치"
                       value="@Weight(o.Id)" @onchange="e => SetWeight(o.Id, e.Value)" />
            </div>
        }
    </div>

    <button class="roll tj-search" @onclick="Search" disabled="@(searching || !weights.Values.Any(w => w != 0))">
        @(searching ? "찾는 중..." : "시드 찾기")
    </button>

    @if (hits is not null)
    {
        @if (hits.Length == 0)
        {
            <p class="tj-help">가중치를 준 패시브가 나오는 시드가 없어요.</p>
        }
        else
        {
            <div class="tj-trade">
                <label>
                    리그
                    <select @bind="league">
                        @foreach (var l in leagues)
                        {
                            <option value="@l">@l</option>
                        }
                    </select>
                </label>
                <label class="check">
                    <input type="checkbox" @bind="anyConqueror" />
                    <span>정복자 상관없이 (핵심 패시브만 달라요)</span>
                </label>
                <span class="tj-trade-top">
                    상위 @(TopSeeds.Length)개 시드 한 번에:
                    <a href="@TradeUrl(TradeLinks.Kakao, TopSeeds)" target="_blank" rel="noopener">카카오 거래소</a>
                    <a href="@TradeUrl(TradeLinks.Global, TopSeeds)" target="_blank" rel="noopener">국제 거래소</a>
                </span>
            </div>
            <p class="tj-help">점수가 높은 시드 @(hits.Length)개 · 시드를 누르면 위에서 그 시드로 보여 드려요 · 오른쪽 링크는 그 시드만 거래소에서 찾아요</p>
            <ol class="tj-hits">
                @foreach (var h in hits)
                {
                    <li>
                        <button type="button" @onclick="() => OnPick.InvokeAsync(h.Seed)">
                            <span class="tj-hit-seed">@h.Seed.ToString("N0")</span>
                            <span class="tj-hit-score">@h.Score.ToString("0.##", CultureInfo.InvariantCulture)점</span>
                            <span class="tj-hit-counts">
                                @foreach (var (outcome, count) in h.Counts)
                                {
                                    <span>@Short(outcome) ×@count</span>
                                }
                            </span>
                        </button>
                        <a href="@TradeUrl(TradeLinks.Kakao, [h.Seed])" target="_blank" rel="noopener" title="카카오 거래소에서 이 시드 찾기">카카오</a>
                        <a href="@TradeUrl(TradeLinks.Global, [h.Seed])" target="_blank" rel="noopener" title="국제 거래소에서 이 시드 찾기">국제</a>
                    </li>
                }
            </ol>
        }
    }
}

@code {
    [Parameter, EditorRequired] public TreeNode Socket { get; set; } = default!;
    [Parameter, EditorRequired] public TimelessJewelType Jewel { get; set; } = default!;
    /// <summary>거래소 검색에 쓸 정복자 (정복자 상관없이를 켜면 이 주얼의 정복자 셋 모두)</summary>
    [Parameter, EditorRequired] public Conqueror Conqueror { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyCollection<int> Chosen { get; set; } = [];
    /// <summary>고른 노드가 바뀔 때마다 올라가는 번호 (같은 HashSet을 고쳐 쓰므로 이것으로 바뀐 것을 압니다)</summary>
    [Parameter] public int ChosenVersion { get; set; }
    [Parameter] public EventCallback<int> OnPick { get; set; }

    // 거래소: 리그 목록은 starter-builds.json의 이번 리그(poe.ninja)에서 만듭니다.
    string[] leagues = TradeLinks.Leagues(null);
    string league = "Standard";
    bool anyConqueror;

    Conqueror[] TradeConquerors => anyConqueror ? Jewel.Conquerors : [Conqueror];

    /// <summary>한 번에 검색할 상위 시드 (정복자 상관없이면 시드마다 조건이 셋이라 PoB처럼 줄입니다)</summary>
    int[] TopSeeds => (hits ?? []).Take(Math.Max(1, TradeLinks.MaxFilters / TradeConquerors.Length)).Select(h => h.Seed).ToArray();

    string TradeUrl(TradeSite site, int[] seeds) => TradeLinks.Url(site, league, TradeConquerors, seeds);

    protected override async Task OnInitializedAsync()
    {
        var data = await StarterBuilds.GetAsync();
        leagues = TradeLinks.Leagues(data?.Ninja?.League);
        league = leagues[0];
    }

    SeedOutcome[]? outcomes;
    SeedHit[]? hits;
    readonly Dictionary<int, double> weights = [];
    string filter = "";
    bool onlyWeighted;
    bool failed;
    bool searching;
    string? loadedFor;

    IEnumerable<SeedOutcome> VisibleOutcomes => (outcomes ?? []).Where(o =>
        (!onlyWeighted || weights.GetValueOrDefault(o.Id) != 0)
        && (filter == "" || o.Title.Contains(filter, StringComparison.OrdinalIgnoreCase)
            || o.Lines.Any(l => l.Contains(filter, StringComparison.OrdinalIgnoreCase))));

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Jewel.LutName}/{Socket.I}/{ChosenVersion}";
        if (key == loadedFor) return;
        var jewelChanged = loadedFor is null || !loadedFor.StartsWith($"{Jewel.LutName}/{Socket.I}/");
        loadedFor = key;
        hits = null;
        failed = false;
        // 다른 주얼·소켓이면 나오는 패시브가 달라서 가중치를 비웁니다.
        if (jewelChanged) weights.Clear();
        if (Chosen.Count == 0)
        {
            outcomes = null;
            return;
        }

        outcomes = null;
        var result = await Changes.OutcomesAsync(Socket, Jewel, Chosen.ToArray());
        if (loadedFor != key) return;  // 그 사이 또 바뀌었으면 버립니다.
        outcomes = result;
        failed = result is null;
    }

    string Weight(int id) => weights.TryGetValue(id, out var w) && w != 0 ? w.ToString(CultureInfo.InvariantCulture) : "";

    void SetWeight(int id, object? value)
    {
        if (double.TryParse(value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var w) && w != 0)
            weights[id] = w;
        else
            weights.Remove(id);
    }

    async Task Search()
    {
        searching = true;
        StateHasChanged();
        await Task.Yield();  // "찾는 중" 표시가 먼저 그려지게 합니다.
        hits = await Changes.SearchAsync(Socket, Jewel, Chosen.ToArray(), new Dictionary<int, double>(weights));
        failed = hits is null;
        searching = false;
    }

    /// <summary>결과 칩에 쓸 짧은 이름: 바뀌는 패시브는 이름, 덧붙는 능력치는 첫 줄</summary>
    static string Short(SeedOutcome o) => o.Title == "능력치 추가" ? o.Lines.FirstOrDefault() ?? o.Title : o.Title;
}
